{
  "name": "@auren/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.19.0 <26",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "check": "pnpm --filter @auren/schemas build && node scripts/verify-workspace.mjs && node scripts/verify-blocks.mjs",
    "build": "turbo run build && pnpm registry:build",
    "dev": "turbo run dev",
    "registry:build": "pnpm --filter @auren/schemas build && node scripts/build-registry.mjs",
    "test": "pnpm --filter @auren/schemas build && node --test scripts/verify-blocks.test.mjs scripts/verify-workspace.test.mjs scripts/registry-build.test.mjs && turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write ."
  },
  "devDependencies": {
    "@auren/schemas": "workspace:*",
    "@biomejs/biome": "2.5.10",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/semver": "7.7.1",
    "react": "19.2.8",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
